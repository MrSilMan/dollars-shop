generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  invitesSent   StaffInvitation[] @relation("SentInvitations")

  @@map("users")
}

model StaffInvitation {
  id        String    @id @default(cuid())
  email     String
  role      Role
  token     String    @unique @default(cuid())
  invitedBy String
  inviter   User      @relation("SentInvitations", fields: [invitedBy], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("staff_invitations")
}

enum Role {
  CUSTOMER
  INVENTORY
  SALES
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum FontScale {
  SMALL
  MEDIUM
  LARGE
}

model AppSettings {
  id           String    @id @default("default")
  primaryColor String    @default("#1A4D3A")
  accentColor  String    @default("#F5A623")
  bgColor      String    @default("#F8FAF9")
  textColor    String    @default("#1A2E25")
  logoUrl      String?
  faviconUrl   String?
  appName      String    @default("Dollar Shop")
  footerText   String    @default("© 2025 Dollar Shop — Quality Everyday. Every Dollar Counts.")
  // Footer "Contact" column — address, phone, email and opening hours
  contactAddress String  @default("123 Samora Machel Ave, Harare, Zimbabwe")
  contactPhone   String  @default("+263 77 256 6468")
  contactEmail   String  @default("hello@dollarshop.co.zw")
  contactHours   String  @default("Mon–Sat: 8AM–6PM\nSun: 9AM–1PM")
  // Footer social links — blank hides the icon
  facebookUrl    String  @default("https://facebook.com/dollarshopzw")
  instagramUrl   String  @default("https://instagram.com/dollarshopzw")
  fontScale             FontScale @default(MEDIUM)
  whatsappAdminNumbers  String[]  @default([])
  // How many ZWG (ZiG) one US dollar buys, for EcoCash pay-in-ZWG at checkout
  zwgRate               Decimal   @default(39) @db.Decimal(12, 4)
  updatedAt             DateTime  @updatedAt

  @@map("app_settings")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String
  line1     String
  line2     String?
  city      String
  province  String
  country   String   @default("Zimbabwe")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("addresses")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("Subcategory", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategory")
  products    Product[]
  extraProducts Product[] @relation("ProductExtraCategories")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  sku            String   @unique
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  lowStockAlert  Int      @default(10)
  images         String[]
  tags           String[]
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  additionalCategories Category[] @relation("ProductExtraCategories")
  featured       Boolean  @default(false)
  isActive       Boolean  @default(true)
  weight         Decimal? @db.Decimal(8, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  variants      ProductVariant[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  variantId String?
  quantity  Int
  product   Product               @relation(fields: [productId], references: [id])
  variant   ProductVariant?       @relation(fields: [variantId], references: [id])
  user      User?                 @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod
  paymentRef      String?
  // DELIVERY: shippingAddress is the customer's address. PICKUP: the customer
  // collects in store, and shippingAddress holds the store's address instead.
  fulfillmentType FulfillmentType @default(DELIVERY)
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  shippingAddress Json
  notes           String?
  couponId        String?
  couponCode      String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  transactions    PaymentTransaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

// One row per charge attempt against a payment provider. clientCorrelator is the
// provider-side idempotency key (EcoCash rejects duplicates), so retries after a
// failed attempt must create a new row rather than reuse one.
model PaymentTransaction {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id])
  provider         PaymentMethod
  clientCorrelator String            @unique
  msisdn           String
  amount           Decimal           @db.Decimal(10, 2)
  currency         String            @default("USD")
  // USD→currency rate used at charge time (null for USD charges). Kept so
  // refunds and reconciliation reproduce the exact amount that was charged.
  exchangeRate     Decimal?          @db.Decimal(12, 4)
  status           TransactionStatus @default(PENDING)
  // EcoCash serverReferenceCode/ecocashReference — required to issue a refund
  providerRef      String?
  failureReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([orderId])
  @@map("payment_transactions")
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  ECOCASH
  INNBUCKS
  CASH_ON_DELIVERY
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  order           Order   @relation(fields: [orderId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
  productName     String
  productSku      String
  price           Decimal @db.Decimal(10, 2)
  quantity        Int
  subtotal        Decimal @db.Decimal(10, 2)
  variantSnapshot String?

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("reviews")
}

model HeroSlide {
  id        String   @id @default(cuid())
  tag       String
  tagBg     String   @default("#ffffff33")
  headline  String
  sub       String
  ctaLabel  String
  ctaHref   String   @default("/shop")
  ctaBg     String   @default("#FFFFFF")
  imageUrl  String?
  bgFrom    String   @default("#FF4400")
  bgTo      String   @default("#E63900")
  bgNone    Boolean  @default(false)
  ctaNone   Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model SidePromo {
  id        String   @id @default(cuid())
  label     String
  headline  String
  href      String   @default("/shop")
  imageUrl  String?
  bgFrom    String   @default("#FF4400")
  bgTo      String   @default("#E63900")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("side_promos")
}

model PromoCard {
  id        String   @id @default(cuid())
  amount    String
  label     String
  desc      String
  sub       String
  href      String   @default("/shop")
  leftBg    String
  rightBg   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promo_cards")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupName   String   @default("Variant")
  value       String
  sku         String?
  stock       Int      @default(0)
  priceAdjust Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  cartItems   CartItem[]
  createdAt   DateTime @default(now())

  @@map("product_variants")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  type        CouponType
  value       Decimal     @db.Decimal(10, 2)
  minOrder    Decimal?    @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int         @default(0)
  expiresAt   DateTime?
  isActive    Boolean     @default(true)
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("coupons")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  actorRole   String?
  action      String
  entity      String?
  entityId    String?
  entityLabel String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
